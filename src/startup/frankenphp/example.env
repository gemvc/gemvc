# FrankenPHP Configuration (classic mode by default; see Caddyfile.worker for worker mode)
APP_ENV=dev
APP_ENV_SERVER=frankenphp

# Worker mode (optional): restart worker after N requests (0 = unlimited). Also set via MAX_REQUESTS.
# FRANKENPHP_MAX_REQUESTS=500
# FRANKENPHP_WORKER_NUM=2

# Core APM Configuration
APM_NAME=TraceKit
APM_ENABLED=1
APM_SAMPLE_RATE="1.0"
APM_TRACE_CONTROLLER=1
APM_TRACE_RESPONSE=1 #for production set to 0
APM_TRACE_DB_QUERY=1
APM_TRACE_REQUEST_BODY=1 #for production set to 0
# TraceKit-Specific Configuration
TRACEKIT_API_KEY=
TRACEKIT_SERVICE_NAME=service-name


# Database Configuration
DB_HOST_CLI_DEV=localhost
DB_HOST=db
DB_PORT=3306
DB_NAME=app_db
DB_CHARSET=utf8mb4
DB_USER=root
DB_PASSWORD=rootpassword
QUERY_LIMIT=10

# Token Configuration
TOKEN_ISSUER='MyCompany'
TOKEN_SECRET='some secret'
LOGIN_TOKEN_VALIDATION_IN_SECONDS=789000
REFRESH_TOKEN_VALIDATION_IN_SECONDS=43200
ACCESS_TOKEN_VALIDATION_IN_SECONDS=1200

# Optional global rate limit. Uncomment to enable.
# REQUEST_RATE_LIMIT_DRIVER=apcu
# apcu | redis | both | none  (default apcu; both = dual check, not failover)
# REQUEST_RATE_LIMIT_PER_SEC=20
# REQUEST_RATE_LIMIT_BLOCK_SECONDS=60
# REQUEST_RATE_LIMIT_SCOPE=both
# REQUEST_RATE_LIMIT_FAIL_MODE=closed
# closed (default) = 429 if chosen backend(s) unavailable; open = allow (local/dev)
# Per-call overrides: requireRateLimitApcu() / requireRateLimitRedis() / requireRateLimitBoth()

# Family trust (Phase 2a) — same secret on every member that sends OR receives internal calls
# GEMVC_INTERNAL_SECRET='long-random-shared-secret'
# GEMVC_INTERNAL_SECRET_PREVIOUS=
# GEMVC_INTERNAL_TRUST_SKEW_SECONDS=60
# GEMVC_SERVICE_NAME=my-service

# Family mesh discovery (Phase 2b) — logical name => base URL
# GEMVC_SERVICES_JSON={"auth":"http://noam-auth","billing":"http://billing"}

# URL Configuration
SERVICE_IN_URL_SECTION=1
METHOD_IN_URL_SECTION=2
