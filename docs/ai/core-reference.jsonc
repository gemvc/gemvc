{
  // GEMVC core reference for AI — class signatures must match source (docs follow code).
  // Not HTTP endpoint docs. Human/AI entry: docs/ai/INDEX.md → CANONICAL → CORE_REFERENCE.
  "framework": {
    "name": "GEMVC",
    "type": "PHP REST API Framework",
    "version": "5.14.0",
    "library_package": "gemvc/library",
    "ecosystem_doc": "docs/guides/ecosystem.md",
    "ai_docs": "docs/ai/INDEX.md",
    "core_reference": "docs/ai/CORE_REFERENCE.md",
    "target_platforms": ["OpenSwoole", "Apache", "Nginx", "FrankenPHP"],
    "databases": ["mysql", "pgsql", "sqlite"],
    "architecture": {
      "layers": [
        { "name": "API", "location": "app/api/", "purpose": "Schema validation, auth, call Controller" },
        { "name": "Controller", "location": "app/controller/", "purpose": "Orchestration: map request → Model, createList" },
        { "name": "Model", "location": "app/model/", "purpose": "Business rules, transforms, composition workflows" },
        { "name": "Table", "location": "app/table/", "purpose": "Database: Table (physical) or ViewTable (SQL view)" }
      ],
      "note": "4-layer strongly recommended; bypass possible but discouraged; ViewTable for JOIN-heavy reads"
    }
  },
  "packages": {
    "gemvc/library": "Framework hub (incl. ViewTable, ViewGenerator, db:migrate --all)",
    "gemvc/helper": "^1.1 TypeChecker, CryptHelper, …",
    "gemvc/connection-contracts": "DB interfaces",
    "gemvc/connection-pdo": "^1.1 Apache/Nginx/FrankenPHP/CLI",
    "gemvc/connection-openswoole": "OpenSwoole pools",
    "gemvc/apm-contracts": "ApmInterface / ApmFactory",
    "gemvc/apm-tracekit": "Default TraceKit provider",
    "gemvc/http-client": "Outbound HTTP",
    "gemvc/cli-base": "^1.0.1 CLI foundation",
    "gemvc/cli-dev": "require-dev: create:*, db:list|describe|…, admin:*"
  },
  "cli_base": {
    "package": "gemvc/cli-base",
    "documentation": "vendor/gemvc/cli-base/AI-Assistant.md",
    "rules": [
      "Custom commands extend Gemvc\\CLI\\Command",
      "Use CliColor enum in write(), never string color names"
    ]
  },
  "request_class": {
    "namespace": "Gemvc\\Http\\Request",
    "properties": {
      "post": { "type": "array" },
      "get": { "type": "string|array" },
      "put": { "type": "array|null" },
      "patch": { "type": "array|null" },
      "files": { "type": "array|null" },
      "cookies": { "type": "mixed" },
      "authorizationHeader": { "type": "null|string|array" },
      "isAuthenticated": { "type": "bool" },
      "isAuthorized": { "type": "bool" },
      "apm": { "type": "ApmInterface|null" }
    },
    "auth_http_codes": {
      "401": "No token / cannot extract Authorization",
      "403": "Token present but invalid (verify failed), or valid token with wrong role"
    },
    "methods": {
      "definePostSchema": { "signature": "definePostSchema(array $schema): bool" },
      "defineGetSchema": { "signature": "defineGetSchema(array $schema): bool" },
      "definePutSchema": { "signature": "definePutSchema(array $schema): bool" },
      "definePatchSchema": { "signature": "definePatchSchema(array $schema): bool" },
      "validateStringPosts": { "signature": "validateStringPosts(array $stringPosts): bool" },
      "intValueGet": { "signature": "intValueGet(string $key): int|false" },
      "intValuePost": { "signature": "intValuePost(string $key): int|false" },
      "floatValueGet": { "signature": "floatValueGet(string $key): float|false" },
      "floatValuePost": { "signature": "floatValuePost(string $key): float|false" },
      "stringValueGet": { "signature": "stringValueGet(string $key): string|false" },
      "stringValuePost": { "signature": "stringValuePost(string $key): string|false" },
      "decimalValueGet": { "signature": "decimalValueGet(string $key, string $type = 'decimal'): string|false" },
      "decimalValuePost": { "signature": "decimalValuePost(string $key, string $type = 'decimal'): string|false" },
      "auth": { "signature": "auth(?array $authRules = null): bool" },
      "returnResponse": { "signature": "returnResponse(): JsonResponse" },
      "findable": { "signature": "findable(array $fields): bool", "description": "LIKE filters" },
      "filterable": { "signature": "filterable(array $fields): bool", "description": "Exact filters" },
      "sortable": { "signature": "sortable(array $fields): bool" },
      "setPageNumber": { "signature": "setPageNumber(): bool" },
      "setPerPage": { "signature": "setPerPage(): bool" },
      "getPageNumber": { "signature": "getPageNumber(): int" },
      "getPerPage": { "signature": "getPerPage(): int" },
      "mapPostToObject": {
        "signature": "mapPostToObject(object $object, ?array $manualMap = null): object|null",
        "note": "Manual map key = request field (= property). Value ending in () calls method; otherwise value ignored."
      },
      "mapPutToObject": { "signature": "mapPutToObject(object $object, ?array $manualMap = null): object|null" },
      "mapPatchToObject": { "signature": "mapPatchToObject(object $object, ?array $manualMap = null): object|null" }
    }
  },
  "response_factory": {
    "namespace": "Gemvc\\Http\\Response",
    "methods": {
      "success": { "code": 200, "signature": "success(mixed $data, ?int $count = null, ?string $service_message = null): JsonResponse" },
      "created": { "code": 201, "signature": "created(mixed $data, ?int $count = null, ?string $service_message = null): JsonResponse" },
      "updated": { "code": 209, "signature": "updated(mixed $data, ?int $count = null, ?string $service_message = null): JsonResponse" },
      "deleted": { "code": 210, "signature": "deleted(mixed $data, ?int $count = null, ?string $service_message = null): JsonResponse" },
      "successButNoContentToShow": { "code": 204, "signature": "successButNoContentToShow(mixed $data, ?int $count = null, ?string $service_message = null): JsonResponse" },
      "badRequest": { "code": 400, "signature": "badRequest(?string $service_message = null): JsonResponse" },
      "unauthorized": { "code": 401, "signature": "unauthorized(?string $service_message = null): JsonResponse" },
      "forbidden": { "code": 403, "signature": "forbidden(?string $service_message = null): JsonResponse" },
      "notFound": { "code": 404, "signature": "notFound(?string $service_message = null): JsonResponse" },
      "notAcceptable": { "code": 406, "signature": "notAcceptable(?string $service_message = null): JsonResponse" },
      "conflict": { "code": 409, "signature": "conflict(?string $service_message = null): JsonResponse" },
      "unsupportedMediaType": { "code": 415, "signature": "unsupportedMediaType(?string $service_message = null): JsonResponse" },
      "unprocessableEntity": { "code": 422, "signature": "unprocessableEntity(?string $service_message = null): JsonResponse" },
      "tooManyRequests": { "code": 429, "signature": "tooManyRequests(?string $service_message = null): JsonResponse" },
      "internalError": { "code": 500, "signature": "internalError(?string $service_message = null): JsonResponse" },
      "unknownError": { "signature": "unknownError(mixed $data, ?string $service_message = null): JsonResponse" }
    },
    "json_response": {
      "show": "show(): void",
      "showSwoole": "showSwoole(object $swooleResponse): void"
    }
  },
  "api_service": {
    "ApiService": {
      "requireAuth": "requireAuth(?array $roles = []): void  // throws AuthException",
      "callController": "callController(Controller $c): ControllerTracingProxy",
      "validateOrFail": "validateOrFail(array $schema): void  // throws ValidationException",
      "validateStringOrFail": "validateStringOrFail(array $schema): void",
      "validatePosts": "validatePosts(array $schema): void",
      "mockResponse": "mockResponse(string $method): array",
      "magic_controllers": true
    },
    "SwooleApiService": {
      "deprecated": true,
      "extends": "ApiService",
      "note": "Prefer ApiService; keeps safeValidatePosts / safeValidateStringPosts for legacy return style",
      "safeValidatePosts": "safeValidatePosts(array $schema): ?JsonResponse",
      "validatePosts": "inherited — throws ValidationException"
    },
    "ProtectedSwooleApiService": {
      "deprecated": true,
      "extends": "ProtectedApiService"
    },
    "ApiServiceSharedTrait": {
      "requireAuth": true,
      "requireRateLimit": true,
      "callController": true,
      "magic_controllers": true
    }
  },
  "controller": {
    "namespace": "Gemvc\\Core\\Controller",
    "methods": {
      "createModel": { "signature": "protected createModel(object $model): object" },
      "createList": { "signature": "public createList(object $model, ?string $columns = null): JsonResponse" },
      "listJsonResponse": { "signature": "public listJsonResponse(object $model, ?string $columns = null): JsonResponse" }
    }
  },
  "table_orm": {
    "namespace": "Gemvc\\Database\\Table",
    "required_methods": ["getTable(): string"],
    "subclass_conventions": [
      "public function defineSchema(): array — not on base Table; required for db:migrate via method_exists; must be public"
    ],
    "required_properties": [{ "name": "_type_map", "type": "array" }],
    "query_builder_methods": {
      "select": { "signature": "select(?string $columns = null): self" },
      "where": { "signature": "where(string $column, mixed $value): self" },
      "whereEqual": { "signature": "whereEqual(string $column, mixed $value): self" },
      "whereIn": { "signature": "whereIn(string $column, array $values): self" },
      "whereNotIn": { "signature": "whereNotIn(string $column, array $values): self" },
      "whereLike": { "signature": "whereLike(string $column, string $value): self" },
      "whereOr": { "signature": "whereOr(string $column, mixed $value): self" },
      "join": { "signature": "join(string $table, string $condition, string $type = 'INNER'): self" },
      "orderBy": { "signature": "orderBy(?string $columnName = null, ?bool $ascending = null): self", "note": "true=ASC; false/null=DESC; null column=PK" },
      "limit": { "signature": "limit(int $limit): self" },
      "noLimit": { "signature": "noLimit(): self", "note": "Disable pagination LIMIT/OFFSET" },
      "all": { "signature": "all(): self", "note": "Alias of noLimit()" },
      "forUpdate": { "signature": "forUpdate(bool $enable = true): self", "note": "SELECT … FOR UPDATE; use inside beginTransaction (MySQL InnoDB / PostgreSQL)" },
      "run": { "signature": "run(): ?array" }
    },
    "transaction_methods": {
      "beginTransaction": { "signature": "beginTransaction(): bool" },
      "commit": { "signature": "commit(): bool" },
      "rollback": { "signature": "rollback(): bool" }
    },
    "crud_methods": {
      "insertSingleQuery": { "signature": "insertSingleQuery(): ?static" },
      "updateSingleQuery": { "signature": "updateSingleQuery(): ?static" },
      "deleteByIdQuery": { "signature": "deleteByIdQuery(int|string $id): int|string|null" },
      "deleteSingleQuery": { "signature": "deleteSingleQuery(): ?int" },
      "safeDeleteQuery": { "signature": "safeDeleteQuery(): ?static", "requires": "deleted_at" },
      "restoreQuery": { "signature": "restoreQuery(): ?static" },
      "activateQuery": { "signature": "activateQuery(int|string $id): ?int" },
      "deactivateQuery": { "signature": "deactivateQuery(int|string $id): ?int" },
      "getError": { "signature": "getError(): ?string" },
      "setError": { "signature": "setError(?string $error): void" }
    },
    "schema_helpers": ["primary", "autoIncrement", "unique", "foreignKey", "index", "check", "fullText"],
    "atomic_money_transfers": {
      "guide": "docs/guides/model.md#atomic-money-transfers-pessimistic-lock",
      "pattern": "beginTransaction → select()->whereIn()->orderBy('id')->forUpdate()->run() → BCMath → updateSingleQuery on $this (not hydrated rows) → commit/rollback",
      "dont": "Never DatabaseManagerFactory…->getPdo() for multi-step money; never float balances"
    },
    "note": "No Table::offset() or Table::from() — do not invent them"
  },
  "view_table_orm": {
    "namespace": "Gemvc\\Database\\ViewTable",
    "extends": "Gemvc\\Database\\Table",
    "required_methods": [
      "getTable(): string",
      "defineView(): string"
    ],
    "optional_methods": [
      "viewDependsOn(): list<class-string<Table>>",
      "createViewQuery(?PDO $pdo = null): bool",
      "replaceViewQuery(?PDO $pdo = null): bool",
      "dropViewQuery(?PDO $pdo = null): bool"
    ],
    "related": ["ViewGenerator", "TableMigrateOrder"],
    "rules": [
      "Public props + $_type_map match SELECT aliases (flat)",
      "Row insert/update/delete hard-fail — writes on base Tables",
      "db:migrate ViewTableClass or db:migrate --all",
      "Do not invent Eloquent 1:n on views — nest in Model"
    ],
    "guide": "docs/guides/database.md#sql-views-via-viewtable-recommended"
  },
  "validation_types": {
    "from_TypeChecker": [
      "string", "int", "integer", "float", "number", "double", "bool", "boolean",
      "array", "email", "url", "date", "datetime", "json", "jsonb",
      "ip", "ipv4", "ipv6", "decimal", "decimal:P,S", "hex", "uuid", "slug",
      "positive_int", "timestamp"
    ],
    "optional": { "prefix": "?", "example": "?name" },
    "length_validation": {
      "method": "validateStringPosts",
      "format": "field => 'min|max'"
    }
  },
  "cli_commands": {
    "library": {
      "init": "gemvc init [--swoole|--apache|--nginx] [--db=mysql|postgres|sqlite] [--non-interactive]",
      "db:migrate": "gemvc db:migrate TableOrViewClass [--force] [--sync-schema] | gemvc db:migrate --all"
    },
    "cli_dev_require_dev": {
      "create:crud": "gemvc create:crud Name",
      "create:service": "gemvc create:service Name [-cmt]",
      "create:controller": "gemvc create:controller Name [-mt]",
      "create:model": "gemvc create:model Name [-t]",
      "create:table": "gemvc create:table Name",
      "db:init": "gemvc db:init",
      "db:list": "gemvc db:list",
      "db:describe": "gemvc db:describe TableName",
      "db:drop": "gemvc db:drop TableName",
      "db:unique": "gemvc db:unique …",
      "admin:setadmin": "gemvc admin:setadmin",
      "admin:setpassword": "gemvc admin:setpassword"
    }
  },
  "helpers": {
    "package": "gemvc/helper",
    "CryptHelper": {
      "hashPassword": "hashPassword(string $password): string",
      "passwordVerify": "passwordVerify(string $passwordToCheck, string $hash): bool",
      "encryptString": "encryptString(string $string, string $key): false|string",
      "decryptString": "decryptString(string $encryptedString, string $key): false|string"
    },
    "TypeChecker": {
      "check": "check(mixed $type, mixed $value, array $options = []): bool"
    },
    "FileHelper": {
      "encrypt": "encrypt(): false|string",
      "decrypt": "decrypt(): false|string"
    },
    "ImageHelper": {
      "convertToWebP": "convertToWebP(int $quality = 80): bool"
    }
  },
  "dont_create": {
    "routes": "No routes config files",
    "sanitization": "No manual input sanitization",
    "raw_sql": "No string-concat SQL",
    "ghost_apis": "Do not invent methods not in source (e.g. Table::offset, CryptHelper::encrypt)"
  },
  "must_extend": {
    "api_classes": "ApiService or ProtectedApiService (deprecated: SwooleApiService / ProtectedSwooleApiService)",
    "controller_classes": "Controller",
    "model_classes": "Table subclass or composition",
    "table_classes": "Table or ViewTable"
  },
  "url_structure": {
    "pattern": "/api/{ServiceName}/{MethodName}",
    "examples": ["/api/User/create", "/api/User/read/?id=1", "/api/Product/list/?sort_by=name"]
  }
}
